# TGBot Ultra - Railway PostgreSQL 生产环境变量模板
# 用于 Railway PostgreSQL 服务。密码请在 Railway 中生成强随机值。

# PostgreSQL 镜像初始化变量
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RAILWAY_PASSWORD
PGDATA=/var/lib/postgresql/data/pgdata

# Railway 私网连接变量
PGDATABASE=${{POSTGRES_DB}}
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}

# Railway TCP Proxy 公网连接变量
# 仅用于本地管理或首次导入 DB_PostgreSQL.sql；应用服务应使用上面的私网连接。
DATABASE_PUBLIC_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}

# Railway PostgreSQL 运行参数
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
SSL_CERT_DAYS=820
