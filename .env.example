#############################################
# TGBot Ultra - 统一环境配置
# 所有服务共享此文件，按区块区分归属
#############################################

# ================================================================
# 【共用配置】Admin / Job / 其他所有服务共同使用
# ================================================================

# ---------- App ----------
APP_NAME=
APP_ENV=
APP_DEBUG=
APP_KEY=
APP_URL=
TIMEZONE=

# ---------- 数据库 (PostgreSQL) ----------
DB_CONNECTION=
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=
DB_CHARSET=
DB_COLLATION=
DB_SOCKET=
DB_FOREIGN_KEYS=
DB_CONNECT_TIMEOUT=
DB_RETRY_AFTER=
DB_MAX_RETRIES=
DB_KEEPALIVE=
DB_KEEPALIVE_IDLE=
DB_KEEPALIVE_INTERVAL=
DB_KEEPALIVE_COUNT=
DB_IDLE_TIMEOUT=
DB_RETRY_INTERVAL=

# ---------- Redis ----------
REDIS_CLIENT=
REDIS_CLUSTER=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=
REDIS_PREFIX=
REDIS_MAX_IDLE_TIME=

# ---------- 缓存 / 会话 / 队列 ----------
BROADCAST_DRIVER=
CACHE_DRIVER=
CACHE_PREFIX=
FILESYSTEM_DRIVER=
FILESYSTEM_CLOUD=
QUEUE_CONNECTION=
SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_CONNECTION=
SESSION_STORE=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

# ---------- 业务服务 ----------
API_WEB_URL=
NL_API_BASE_URL=
WEB_URL=
TG_BOT_AUTO_CLONE_CONFIG=

# ---------- TRON API ----------
TRONSCAN_API_KEYS=
TRONGRID_API_KEYS=
TRONGASID_BISHU_PAYMENT=

# ---------- 安全 ----------
BCRYPT_ROUNDS=
SCAN_CACHEABLE=

# ---------- 兼容字段 ----------
API_URL=
THIRD_URL=
DEFAULT_USER_PIC=

# ---------- 对象存储 OSS ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKETNAME=
OSS_CITY=
OSS_NETWORK_TYPE=
OSS_URL=

# ---------- 代理头兼容 ----------
HTTP_CLIENT_IP=
HTTP_FORWARDED=
HTTP_FORWARDED_FOR=
HTTP_X_FORWARDED=
HTTP_X_FORWARDED_FOR=
REMOTE_ADDR=

# ---------- Mail ----------
MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_LOG_CHANNEL=

# ---------- 第三方服务 ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=
POSTMARK_TOKEN=
SPARKPOST_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# ---------- Memcached / DynamoDB / SQS ----------
MEMCACHED_HOST=
MEMCACHED_PORT=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
DYNAMODB_CACHE_TABLE=
SQS_PREFIX=
SQS_QUEUE=

# ---------- Papertrail ----------
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# ---------- MySQL SSL（仅兼容，PostgreSQL 可忽略） ----------
MYSQL_ATTR_SSL_CA=

# ---------- Cloudflare Turnstile ----------
TURNSTILE_ENABLE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ---------- 日志 ----------
LOG_CHANNEL=
LOG_LEVEL=
LOG_SLACK_WEBHOOK_URL=
LOG_STDERR_FORMATTER=

# ---------- Cloudflare Tunnel ----------
CFTUN_ID=
TUNNEL_TOKEN=
# ---------- 机器人 ----------
BOT_NAME=
BOT_PUBLIC_IP=


# ================================================================
# 【Admin 专用】后台管理服务 (Laravel/PHP)
# ================================================================

# App 名称
ADMIN_APP_NAME=

# HTTPS 反代
IS_HTTPS=

# IP 访问控制（允许直接通过 IP+端口 访问，false 则只允许域名）
IP_ACCESS_ENABLE=

# ---------- Admin 端口 ----------
# Docker 宿主机端口（修改后 docker compose up -d admin 生效）
ADMIN_PORT=


# ================================================================
# 【Job 专用】任务处理服务 (Hyperf/Swoole)
# ================================================================

# 任务调度
APP_CRONTAB=
REDIS_QUEUE=

# 机器人进程名称（用于区分不同 job 进程）
JOB_APP_NAME=
JOB_BOT_PROCESS_NAME=

# ---------- Job 端口 ----------
# Docker 宿主机端口（修改后 docker compose up -d job 生效）
JOB_PORT=


# ================================================================
# 【数据库 / Redis 宿主机端口】
# ================================================================
POSTGRES_PORT=
REDIS_HOST_PORT=
