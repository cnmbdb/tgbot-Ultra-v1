# Railway Job 生产环境变量
# 可直接粘贴到 Job 服务的 Variables Raw Editor。
# 只需替换 REPLACE_ME 项；Postgres、Redis 为 Railway 跨服务引用。

# 应用
APP_NAME="TGBot Ultra"
JOB_APP_NAME=tgbot-job
JOB_BOT_PROCESS_NAME=hyperf-job
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_ME_SAME_APP_KEY_AS_ADMIN
APP_URL=https://REPLACE_ME_ADMIN_DOMAIN
TIMEZONE=Asia/Shanghai
PORT=9501

# PostgreSQL
DB_CONNECTION=pgsql
DB_DRIVER=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_PREFIX=t_
DB_FOREIGN_KEYS=true
DB_CONNECT_TIMEOUT=10
DB_RETRY_AFTER=5
DB_MAX_RETRIES=3
DB_KEEPALIVE=true
DB_KEEPALIVE_IDLE=600
DB_KEEPALIVE_INTERVAL=30
DB_KEEPALIVE_COUNT=3
DB_IDLE_TIMEOUT=300
DB_RETRY_INTERVAL=5

# Redis
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_AUTH=${{Redis.REDISPASSWORD}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_DB=1
REDIS_MAX_IDLE_TIME=60

# Job 运行配置
APP_CRONTAB=true
BCRYPT_ROUNDS=10
SCAN_CACHEABLE=false

# 业务地址
API_WEB_URL=https://REPLACE_ME_API_WEB_DOMAIN
NL_API_BASE_URL=https://REPLACE_ME_NL_API_DOMAIN
WEB_URL=https://REPLACE_ME_WEB_DOMAIN
TG_BOT_AUTO_CLONE_CONFIG=true

# 日志
LOG_CHANNEL=stack
LOG_LEVEL=warning
