# Railway Admin 生产环境变量
# 可直接粘贴到 Admin 服务的 Variables Raw Editor。
# 只需替换 REPLACE_ME 项；Postgres、Redis 为 Railway 跨服务引用。

# 应用
APP_NAME="TGBot Ultra"
ADMIN_APP_NAME="TGBot Ultra Admin"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_ME_LARAVEL_APP_KEY
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
TIMEZONE=Asia/Shanghai
PORT=80
IS_HTTPS=true
IP_ACCESS_ENABLE=false

# PostgreSQL
DB_CONNECTION=pgsql
DB_DRIVER=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_PREFIX=t_
DB_FOREIGN_KEYS=true

# Redis
REDIS_CLIENT=predis
REDIS_CLUSTER=predis
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_MAX_IDLE_TIME=60
REDIS_DB=0
REDIS_CACHE_DB=1

# Laravel 运行配置
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
BCRYPT_ROUNDS=10
SCAN_CACHEABLE=false

# 业务地址
API_WEB_URL=https://REPLACE_ME_API_WEB_DOMAIN
NL_API_BASE_URL=https://REPLACE_ME_NL_API_DOMAIN
WEB_URL=https://REPLACE_ME_WEB_DOMAIN
TG_BOT_AUTO_CLONE_CONFIG=true

# Cloudflare Turnstile 暂不启用
TURNSTILE_ENABLE=false

# 日志
LOG_CHANNEL=stderr
LOG_LEVEL=warning
