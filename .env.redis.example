# TGBot Ultra - Railway Redis 生产环境变量模板
# 用于 Railway Redis 服务。密码请在 Railway 中生成强随机值。

REDIS_PASSWORD=REPLACE_WITH_STRONG_RAILWAY_PASSWORD
REDIS_PUBLIC_URL=redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}
REDIS_URL=redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}
REDISHOST=${{RAILWAY_PRIVATE_DOMAIN}}
REDISPASSWORD=${{REDIS_PASSWORD}}
REDISPORT=6379
REDISUSER=default

# Railway 当前 Redis 服务使用 redis:8.2.1，并由 Custom Start Command 注入密码。
# 仅设置 REDIS_PASSWORD 不会让原生 Redis 镜像自动启用密码。
